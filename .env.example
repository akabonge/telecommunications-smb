# Backend API Configuration
API_URL=http://localhost:8000/chat

# Pinecone Configuration
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=custom_sources

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_FINE_TUNE_BASE_MODEL=gpt-4.1-mini-2025-04-14

# Model Configuration
MODE=hybrid
MODEL=ft:gpt-4.1-mini-2025-04-14:resume-ai:psap-911-custom-sources:Dbm2AJlm
TOP_K=8

# Application Settings
SYSTEM_NAME=Telecommunications SMB Bot
ALLOW_WEB_ENRICHMENT=false
MAX_CONTEXT_CHUNKS=8
MIN_SOURCE_SCORE=0.35
